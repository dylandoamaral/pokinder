  "scripts": {
    "start": "dotenv -e ../configuration/.env -e ../configuration/.env.shared -- cross-env VITE_VERSION=$VERSION VITE_BACKEND_PORT=$BACKEND_PORT VITE_BACKEND_HOST=$BACKEND_HOST VITE_MINIO_HOST=$MINIO_HOST VITE_MINIO_PORT=$MINIO_PORT vite",
    "start_mac": "source ../configuration/.env && source ../configuration/.env.shared && VITE_VERSION=$VERSION VITE_BACKEND_PORT=$BACKEND_PORT VITE_BACKEND_HOST=$BACKEND_HOST VITE_MINIO_HOST=$MINIO_HOST VITE_MINIO_PORT=$MINIO_PORT vite",
