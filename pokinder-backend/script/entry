#!/bin/bash

# - runs Alembic migrations
# - starts Litestar application

set -o errexit
set -o pipefail
set -o nounset

echo Running migrations...
alembic upgrade head

# Prometheus multiprocess mode: the directory must exist and be empty before workers start.
export PROMETHEUS_MULTIPROC_DIR="${PROMETHEUS_MULTIPROC_DIR:-/tmp/prometheus_multiproc}"
rm -rf "${PROMETHEUS_MULTIPROC_DIR}"
mkdir -p "${PROMETHEUS_MULTIPROC_DIR}"

# WEB_CONCURRENCY = number of uvicorn workers (default 2). Keep workers x (pool_size + max_overflow) < PostgreSQL max_connections.
echo Starting Litestar App...
uvicorn src.app:app --host 0.0.0.0 --workers "${WEB_CONCURRENCY:-2}"