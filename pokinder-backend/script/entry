#!/bin/bash

# - runs Alembic migrations
# - starts Litestar application

set -o errexit
set -o pipefail
set -o nounset

echo Running migrations...
alembic upgrade head


# NOTE: WEB_CONCURRENCY = number of uvicorn workers (default 2). Keep workers x (pool_size + max_overflow) < PostgreSQL max_connections.
echo Starting Litestar App...
uvicorn src.app:app --host 0.0.0.0 --workers "${WEB_CONCURRENCY:-2}"