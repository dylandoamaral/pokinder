init:
	uv sync

local:
	cd src; uv run litestar run --debug

format:
	@uv run black alembic src test
	@uv run isort alembic src test

check:
	@uv run black alembic src test --check
	@uv run isort alembic src test --check
	@uv run ruff check src test

db-generate COMMENT:
	uv run alembic revision --autogenerate -m "{{COMMENT}}" 

db-downgrade:
	uv run alembic downgrade -1

db-upgrade:
	uv run alembic upgrade +1

db-upgrade-all:
	uv run alembic upgrade head

db-fill:
	@uv run python script/1.populate_database.py

db-reset: db-downgrade db-upgrade db-fill

migration-generate VERSION_FROM VERSION_TO:
	@uv run python script/8.generate_sprite_pack_migration.py {{VERSION_FROM}} {{VERSION_TO}}

migration-apply VERSION_FROM VERSION_TO:
	@uv run python script/9.apply_sprite_pack_migration.py {{VERSION_FROM}} {{VERSION_TO}}

migration-commit VERSION:
	git add .
	git commit -m "chore: add sprites pack {{VERSION}}"
	git push
